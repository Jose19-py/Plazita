# Copia este archivo como .env.local y completa los valores
# (Supabase → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU_ANON_PUBLIC_KEY

# URL base del sitio (opcional en desarrollo, ej: https://plazita.vercel.app)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Configuración del sitio
NEXT_PUBLIC_SITE_NOMBRE=Plazita
NEXT_PUBLIC_CORREO_SOPORTE=soporte@plazita.co
NEXT_PUBLIC_RESPONSABLE=[Nombre del responsable]
NEXT_PUBLIC_CIUDAD=[Ciudad]
NEXT_PUBLIC_PAIS=Colombia
